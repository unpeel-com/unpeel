  "additiveBootstrapFields": [
    {
      "field": "hostIsolationTier",
      "required": true,
      "values": [
        "vm",
        "container",
        "host"
      ],
      "note": "Router-owned, data only. Both Host kinds always publish it; macOS is host. Controllers treat an absent value as unknown (compatibility with pre-0.5.0 Hosts)."
    },
    {
      "field": "hostEnvironment",
      "required": false,
      "shape": {
        "kind": "box",
        "id": "<string>"
      },
      "note": "Present only when the Host detects it runs inside a Box (kind box). Additive/optional; no policy in 0.5.0."
    }
  ]
}
