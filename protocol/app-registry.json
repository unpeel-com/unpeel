{
  "design": {
    "id": "unpeel.app.design",
    "channel": "stable",
    "binary": "unpeel-design",
    "name": "Unpeel Design",
    "description": "Terminal visual designer over a folder of HTML artboards; files are the truth and edits write straight back to disk",
    "tint": "#8B5CF6",
    "media_types": [
      "text/html"
    ],
    "file_extensions": {
      "html": "text/html",
      "htm": "text/html"
    },
    "resource_kinds": [
      "folder"
    ],
    "try": [
      "unpeel-design path/to/html-files",
      "(needs a Kitty-graphics terminal: Ghostty or Unpeel)"
    ]
  },
  "diffs": {
    "id": "unpeel.app.diffs",
    "channel": "stable",
    "binary": "unpeel-diffs",
    "name": "Diffs",
    "description": "Standalone borderless Git working-tree viewer with a changed-file list and diff detail",
    "tint": "#64748B",
    "media_types": [],
    "resource_kinds": [
      "git.working-tree"
    ],
    "default_for": [
      "resource:git.working-tree"
    ],
    "try": [
      "unpeel-diffs path/to/project"
    ]
  },
  "filetree": {
    "id": "unpeel.app.filetree",
    "channel": "stable",
    "binary": "unpeel-filetree",
    "name": "Files",
    "description": "Borderless project-scoped file explorer with filtering and native path dragging",
    "tint": "#D97706",
    "media_types": [],
    "resource_kinds": [
      "folder"
    ],
    "default_for": [
      "resource:folder"
    ],
    "try": [
      "unpeel-filetree path/to/project"
    ]
  },
  "github-issues": {
    "id": "unpeel.app.github-issues",
    "channel": "stable",
    "binary": "unpeel-github-issues",
    "name": "GitHub Issues",
    "description": "Borderless GitHub issue list and detail browser for the current Git project",
    "tint": "#6E5494",
    "media_types": [],
    "resource_kinds": [
      "github.repository"
    ],
    "try": [
      "unpeel-github-issues path/to/project"
    ]
  },
  "markdown": {
    "id": "unpeel.app.markdown",
    "channel": "stable",
    "binary": "unpeel-markdown",
    "name": "Markdown",
    "description": "Terminal Markdown editor with live styling, slash commands, mouse editing, and note-vault browsing",
    "tint": "#3B82F6",
    "icon_svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" fill=\"#FFFFFF\"><path d=\"M44.5277 5.99805H3.46577c-1.91435 0-3.46869969 1.62935-3.46869969 3.63464V38.3592c0 2.0062 1.55434969 3.6384 3.46869969 3.6384H44.5277c1.9106 0 3.4687-1.6322 3.4687-3.6384V9.63269c0-2.00529-1.5543-3.63464-3.4687-3.63464ZM26.9967 34.4977h-5.9999V23.9978l-4.4999 5.9999-4.5-5.9999v10.4999H5.99699V13.4979h5.99991l4.5 7.4999 4.4999-7.4999h5.9999v20.9998Zm8.9999 0-7.4999-10.4999h4.5046l-.0047-10.4999h5.9999v10.4999h4.5l-7.4999 10.4999Z\"/></svg>",
    "media_types": [
      "text/markdown"
    ],
    "file_extensions": {
      "md": "text/markdown",
      "markdown": "text/markdown",
      "mdown": "text/markdown",
      "mkd": "text/markdown"
    },
    "resource_kinds": [
      "folder"
    ],
    "default_for": [
      "file:text/markdown"
    ],
    "try": [
      "unpeel-markdown path/to/notes"
    ]
  },
  "usage": {
    "id": "unpeel.app.usage",
    "channel": "stable",
    "binary": "unpeel-usage",
    "name": "Usage",
    "description": "Codex, Claude, Grok, and Muse usage with monthly token totals and alerts",
    "tint": "#F59E0B",
    "media_types": [],
    "try": [
      "unpeel-usage"
    ]
  }
}
