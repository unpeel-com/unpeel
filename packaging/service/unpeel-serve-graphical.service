# Unpeel Host service — Linux systemd user unit bound to the desktop session.
#
# The Computer Use engine (cua-driver) must run inside the desktop session:
# it needs the session's DISPLAY or WAYLAND_DISPLAY and the accessibility
# (AT-SPI) bus on the session D-Bus. The plain unpeel-serve.service starts at
# login with neither, so a Host that should offer computer use installs this
# variant instead (`unpeel serve install --graphical`), which starts when the
# desktop session activates and stops when it ends:
#
#   cp unpeel-serve-graphical.service ~/.config/systemd/user/unpeel-serve.service
#   systemctl --user daemon-reload
#   systemctl --user enable unpeel-serve.service
#
# How the display reaches the service: GNOME, KDE, sway, and other session
# managers import DISPLAY / WAYLAND_DISPLAY / XAUTHORITY into the user manager
# and start graphical-session.target; units bound to that target inherit them.
# DBUS_SESSION_BUS_ADDRESS is the user manager's own bus. A hand-rolled
# session (an Xvfb script, a streamed Xorg desktop such as a Box) has no
# session manager, and graphical-session.target refuses manual start, so it
# starts its own session target that binds it (unpeel-desktop-session.target
# in this directory) once the display is up:
#
#   systemctl --user import-environment DISPLAY XAUTHORITY
#   systemctl --user start unpeel-desktop-session.target
#
# (An ExecStartPre= import inside this unit cannot do that: it would run with
# the user manager's environment, which is exactly what lacks the display.)
#
# `unpeel serve status` reports whether graphical-session.target is active
# and whether a desktop session with a session bus is visible; the Host
# publishes the same truth to Controllers as computerUseAvailable/Ready.
# Everything else about this unit (per-user only, `loginctl enable-linger`,
# diagnostics) matches unpeel-serve.service.

[Unit]
Description=Unpeel Host service (desktop session)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/local/bin/unpeel serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
