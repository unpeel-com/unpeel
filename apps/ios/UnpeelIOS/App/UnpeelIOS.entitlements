<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug expands this to development; Release/TestFlight expands it to
	     production. The App ID must have the Push Notifications capability
	     enabled for the signing team, or automatic signing can't add it. -->
	<key>aps-environment</key>
	<string>$(UNPEEL_APNS_ENVIRONMENT)</string>
</dict>
</plist>
