      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地访问"
          }
        }
      }
    },
    "Unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
    "Serving on this network": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在此网络上提供服务"
          }
        }
      }
    },
    "No paired devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已配对设备。"
          }
        }
      }
    },
    "Link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Link"
          }
        }
      }
    },
    "Direct only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅直连"
          }
        }
      }
    },
    "Share This Workspace…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此工作区…"
          }
        }
      }
    },
    "Share This Mac…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享此 Mac…"
          }
        }
      }
    },
    "Each workspace on this Mac is shared separately.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机上的每个工作区单独共享。"
          }
        }
      }
    },
    "Controls This Workspace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制此工作区"
          }
        }
      }
    },
    "Controls This Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制此 Mac"
          }
        }
      }
    },
    "Devices pair directly over your network and receive their own revocable credential. Revoking one immediately invalidates it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备通过你的网络直接配对，并获得各自可撤销的凭据。撤销会立即使其失效。"
          }
        }
      }
    },
    "Authentication": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "身份验证"
          }
        }
      }
    },
    "Stored token": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储令牌"
          }
        }
      }
    },
    "Security": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全"
          }
        }
      }
    },
    "The hook and MCP servers stay localhost-only. Remote Controllers use a separate LAN server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钩子与 MCP 服务器仅限本机。远程 Controller 使用单独的局域网服务器。"
