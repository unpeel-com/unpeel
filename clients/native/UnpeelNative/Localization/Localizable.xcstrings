      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从不"
          }
        }
      }
    },
    "After %d minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 分钟后"
          }
        }
      }
    },
    "After 1 hour": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 小时后"
          }
        }
      }
    },
    "After 1 day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 天后"
          }
        }
      }
    },
    "After %d hours": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 小时后"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无"
          }
        }
      }
    },
    "%@'s appearance, edited from this window. Mode and color preview here while %@ is active; transparency renders in %@'s own windows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此窗口编辑 %@ 的外观。%@ 处于活动状态时可在此预览模式与颜色；透明度在 %@ 自己的窗口中呈现。"
          }
        }
      }
    },
    "Use %@'s appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@ 的外观"
          }
        }
      }
    },
    "Inherits from %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继承自 %@"
          }
        }
      }
    },
    "%1$@ uses %2$@'s appearance until a setting below is changed. Revert drops %1$@'s own mode, transparency and font; its color stays.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在更改下方某项设置前使用 %2$@ 的外观。还原会丢弃 %1$@ 自己的模式、透明度与字体；颜色保留。"
          }
        }
      }
    },
    "Applies to %@'s window, sidebar and terminal colors.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于 %@ 的窗口、侧栏与终端颜色。"
          }
        }
      }
    },
    "Washes %@'s window chrome — and its dot in the workspace pickers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %@ 的窗口边框上色 — 也会出现在工作区选择器中的色点上。"
          }
        }
      }
    },
    "Applies to %@'s own windows — a running instance updates live.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用于 %@ 自己的窗口 — 正在运行的实例会即时更新。"
          }
        }
      }
    },
    "%1$@'s terminals — family and size; a running instance updates live. ⌘+ / ⌘− / ⌘0 in %2$@'s own windows edit the same value.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的终端 — 字体族与大小；正在运行的实例会即时更新。在 %2$@ 自己的窗口中用 ⌘+ / ⌘− / ⌘0 编辑同一数值。"
          }
        }
      }
    },
    "the selected workspace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选工作区"
          }
        }
      }
    },
    "Auto-stop inactive terminals": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动停止空闲终端"
          }
        }
      }
    },
    "Stopped sessions to keep": {
      "localizations": {
        "zh-Hans": {
