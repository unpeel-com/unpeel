            "value": "终端字体"
          }
        }
      }
    },
    "Default (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认（%@）"
          }
        }
      }
    },
    "%@ (not installed)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（未安装）"
          }
        }
      }
    },
    "Family and size for every terminal on this Mac. ⌘+ and ⌘− zoom all panes together; ⌘0 returns to %d pt. Ghostty falls back to other installed faces for glyphs the chosen font lacks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机每个终端的字体族与大小。⌘+ / ⌘− 一并缩放所有窗格；⌘0 恢复为 %d pt。若所选字体缺少字形，Ghostty 会回退到其他已安装字体。"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Let another Unpeel device control %1$@. Devices you pair here reach %2$@ only — each workspace pairs its own devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许另一台 Unpeel 设备控制 %1$@。在此配对的设备仅能访问 %2$@ — 每个工作区各自配对设备。"
          }
        }
      }
    },
    "Let another Unpeel device control %1$@. %2$@ mints the credentials; this Mac only forwards the one-time sealed exchange.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许另一台 Unpeel 设备控制 %1$@。由 %2$@ 签发凭据；本机仅转发一次性密封交换。"
          }
        }
      }
    },
    "Let another Unpeel device control this workspace.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许另一台 Unpeel 设备控制此工作区。"
          }
        }
      }
    },
    "Let another Unpeel device control this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许另一台 Unpeel 设备控制此 Mac。"
          }
        }
      }
    },
    "No devices are paired with %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有设备与 %@ 配对。"
          }
        }
      }
    },
    "Pair a Device with %@…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将设备与 %@ 配对…"
          }
        }
      }
    },
    "Controls %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制 %@"
          }
        }
      }
    },
    "Each workspace pairs its own devices — a device paired here reaches only %1$@. Revoke devices from %1$@'s own Remote Control settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工作区各自配对设备 — 在此配对的设备仅能访问 %1$@。从 %1$@ 自己的「远程控制」设置中撤销设备。"
          }
        }
      }
    },
    "Unpeel Link enrollment for %1$@'s devices lives in %1$@'s own Remote Control settings; the license covers every workspace on this Mac and is managed from %2$@'s scope.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 设备的 Unpeel Link 注册位于 %1$@ 自己的「远程控制」设置中；许可证覆盖本机所有工作区，并从 %2$@ 的作用域管理。"
          }
        }
      }
    },
    "Each workspace pairs its own devices — a device paired here reaches only %1$@, and its entry is revocable on %1$@ itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工作区各自配对设备 — 在此配对的设备仅能访问 %1$@，并可在 %1$@ 自身撤销其条目。"
          }
        }
      }
    },
    "Unpeel for iPhone is in beta": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpeel for iPhone 处于测试版"
          }
        }
      }
    },
    "Join the TestFlight beta to control this workspace from your phone. Open the invite link on your iPhone to install it with TestFlight.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 TestFlight 测试版以从手机控制此工作区。在 iPhone 上打开邀请链接，用 TestFlight 安装。"
          }
        }
      }
    },
    "Join the TestFlight beta to control this Mac from your phone. Open the invite link on your iPhone to install it with TestFlight.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 TestFlight 测试版以从手机控制此 Mac。在 iPhone 上打开邀请链接，用 TestFlight 安装。"
          }
        }
      }
    },
    "Join the Beta": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入测试版"
          }
        }
      }
    },
