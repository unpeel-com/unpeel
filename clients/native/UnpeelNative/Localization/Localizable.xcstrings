        }
      }
    },
    "GitHub CLI installation instructions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI 安装说明"
          }
        }
      }
    },
    "Connected as @%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接为 @%@"
          }
        }
      }
    },
    "GitHub connection needs attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 连接需要处理"
          }
        }
      }
    },
    "Not connected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接"
          }
        }
      }
    },
    "Authentication comes from an environment token on this Host.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证来自此 Host 上的环境变量令牌。"
          }
        }
      }
    },
    "Disconnect…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开…"
          }
        }
      }
    },
    "Sign in with GitHub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 GitHub 登录"
          }
        }
      }
    },
    "GitHub credentials stay on this Host. This sign-in flow does not send them to Unpeel’s service.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 凭据保留在此 Host。此登录流程不会将它们发送到 Unpeel 服务。"
          }
        }
      }
    },
    "Stored in this Host’s system credential store.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储在此 Host 的系统凭据库中。"
          }
        }
      }
    },
    "GitHub CLI is storing the token in a plain-text file on this Host. Configure a system credential store and sign in again to use it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI 正将此 Host 上的令牌存放在纯文本文件中。请配置系统凭据库并重新登录以使用它。"
          }
        }
      }
    },
    "This GitHub CLI version does not report credential storage. Check it on the Host with gh auth status.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 GitHub CLI 版本不报告凭据存储方式。请在 Host 上用 gh auth status 检查。"
          }
        }
      }
    },
    "Git HTTPS access configured": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配置 Git HTTPS 访问"
          }
        }
      }
    },
    "Configure Git access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置 Git 访问"
          }
        }
      }
    },
    "Paste this code into GitHub in your browser to authorize %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器中将此代码粘贴到 GitHub 以授权 %@。"
          }
        }
      }
    },
    "Copy Code and Open GitHub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制代码并打开 GitHub"
          }
        }
      }
    },
    "Starting GitHub sign-in…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在启动 GitHub 登录…"
          }
        }
      }
    },
    "Cancel sign-in": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消登录"
          }
        }
      }
    },
    "Git identity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 身份"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电子邮件"
          }
        }
      }
    },
    "Used for new commits. Repository-specific Git configuration can override these defaults.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于新提交。仓库特定的 Git 配置可覆盖这些默认值。"
          }
        }
      }
    },
    "Save identity": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存身份"
          }
        }
      }
    },
    "Git is not installed on this Host.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Host 未安装 Git。"
          }
        }
      }
    },
    "Could not open GitHub. Open github.com/login/device and enter the code above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 GitHub。请打开 github.com/login/device 并输入上方代码。"
          }
        }
      }
    },
    "Isolated git checkouts so several agents can work the same repo without touching each other's files. Create one from a git project, or show the worktrees agents make for themselves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立的 git 检出，让多个智能体可在同一仓库上工作而互不干扰。可从 git 项目创建，或显示智能体自建的工作树。"
          }
        }
      }
    },
    "Show agent worktrees": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示智能体工作树"
          }
        }
      }
    },
    "Show the working copies agents create for themselves (Claude Code and similar) as folders under their project in the sidebar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在侧栏中将智能体（Claude Code 等）自建的工作副本显示为其项目下的文件夹。"
          }
        }
      }
    },
    "Agent worktrees": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体工作树"
          }
        }
      }
    },
    "Some agents make their own git worktree of a project to work in. Turn this on to see those worktrees in the sidebar; turning it off hides them again without deleting anything.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分智能体会为项目创建自己的 git 工作树。开启后可在侧栏看到；关闭仅隐藏，不会删除。"
          }
        }
      }
    },
    "Let sessions create worktrees": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许会话创建工作树"
          }
        }
      }
    },
    "Agents can prepare isolated git worktrees as child projects in the sidebar. Launching sessions into them is still up to you. Applies immediately.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可在侧栏中准备独立的 git 工作树作为子项目。是否在其中启动会话仍由你决定。立即生效。"
          }
        }
      }
    },
    "Session access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话权限"
          }
        }
      }
    },
    "Whether sessions may prepare worktrees through Unpeel MCP. They still cannot launch sessions themselves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话是否可通过 Unpeel MCP 准备工作树。它们仍不能自行启动会话。"
          }
        }
      }
    },
    "This workspace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区"
          }
        }
      }
    },
    "Worktrees registered under this workspace's projects.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区项目下注册的工作树。"
          }
        }
      }
    },
    "Each worktree is a child folder of its project in the sidebar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工作树在侧栏中是其项目的子文件夹。"
          }
        }
      }
    },
    "No worktrees in this workspace. Create one from a git project, or turn on Show agent worktrees to adopt copies agents make for themselves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区没有工作树。可从 git 项目创建，或开启「显示智能体工作树」以采纳智能体自建的副本。"
          }
        }
      }
