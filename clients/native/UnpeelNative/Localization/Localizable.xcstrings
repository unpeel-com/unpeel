            "value": "未安装"
          }
        }
      }
    },
    "Off applies immediately to running sessions. Enabling reaches an agent when it starts in a newly configured terminal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭立即作用于运行中的会话。开启后，智能体在新配置的终端中启动时才会收到。"
          }
        }
      }
    },
    "One window per project; every session gets its own tab and all share cookies and logins. Other projects stay separate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个项目一个窗口；每个会话自有标签页，共享 Cookie 与登录。其他项目彼此隔离。"
          }
        }
      }
    },
    "Open resources…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开资源…"
          }
        }
      }
