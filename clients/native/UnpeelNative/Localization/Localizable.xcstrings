      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Git"
          }
        }
      }
    },
    "Agent access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体权限"
          }
        }
      }
