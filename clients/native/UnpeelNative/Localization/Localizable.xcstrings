    "Disconnect @%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开 @%@"
          }
        }
      }
    },
    "Removes this account from GitHub CLI on this Host. Other workspaces using the same server user are affected. It does not revoke the authorization on GitHub.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从该 Host 的 GitHub CLI 移除此账户。使用同一服务器用户的其他工作区会受影响。不会撤销 GitHub 上的授权。"
          }
        }
      }
    },
    "GitHub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub"
          }
        }
      }
    },
    "GitHub CLI is not installed on this Host.": {
