        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行高"
          }
        }
      }
    },
    "Extra space between rows, as a percentage of the font's own cell height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行之间的额外间距，按字体单元高度的百分比计。"
          }
        }
      }
    },
    "Terminal font": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
