    "This workspace is already running": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区已在运行"
          }
        }
      }
    },
    "Another Unpeel instance is already using this workspace's data. Switch to it instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 Unpeel 实例已在使用此工作区的数据。请切换到该实例。"
